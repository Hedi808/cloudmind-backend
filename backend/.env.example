# Existing CloudMind integrations
GITHUB_TOKEN=
GITHUB_USERNAME=
DATABASE_URL=postgresql+psycopg://cloudmind:cloudmind_password@localhost:5432/cloudmind

# Authentication. Keep AUTH_COOKIE_SECURE=false only for local HTTP development.
AUTH_COOKIE_NAME=cloudmind_session
AUTH_SESSION_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_FRONTEND_URL=http://localhost:5173

# Google Cloud Console OAuth 2.0 Web application credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# LLM Planner v1 is opt-in. Ollama runs Llama locally with no API key or usage bill.
CLOUDMIND_LLM_ENABLED=false
CLOUDMIND_LLM_PROVIDER=ollama
CLOUDMIND_LLM_MODEL=llama3.2:3b
CLOUDMIND_LLM_TIMEOUT_SECONDS=120
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Gemini provider.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional paid OpenAI provider. Leave blank when using Gemini.
CLOUDMIND_LLM_REASONING_EFFORT=medium
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
